# Novel Autogrowth Engine local configuration
#
# Copy to .env.local for machine-specific values. Real process environment
# variables take precedence over values in .env / .env.local.

# OpenAI-compatible LLM endpoint. Qwen DashScope compatible mode works with
# the same /chat/completions shape used by the app.
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=

# Optional alias if you prefer keeping DashScope credentials separate.
DASHSCOPE_API_KEY=

# Model routing defaults used for new stories and runtime settings.
NOVEL_AUTOGROWTH_DEFAULT_MODEL=qwen3.6-plus
NOVEL_AUTOGROWTH_FAST_MODEL=qwen3.6-plus

# SQLite persistence. STORY_DB_PATH is still supported for backwards compatibility.
NOVEL_AUTOGROWTH_DB_PATH=apps/api/data/stories.db

# Runtime settings are persisted outside the repo by default. Override only when
# you intentionally want a project-local or test-specific runtime config file.
NOVEL_AUTOGROWTH_RUNTIME_CONFIG_PATH=

# Comma-separated allowed origins for the API CORS middleware.
NOVEL_AUTOGROWTH_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://localhost:3001
